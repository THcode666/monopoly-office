{
  "version": "1.0.0",
  "cards": [
    { "id": "layoff", "deck": "fate", "name": "裁员", "weight": 6, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["HR 找你聊了 15 分钟，然后给了你一份文件。", "你收拾工位时，发现抽屉里的笔筒比想象中满。"], "detail": "失去 25% 现金，职级下降一级", "effects": [ { "op": "cashLossRatio", "ratio": 0.25 }, { "op": "rankCheck", "delta": -1 } ], "icon": "box" },
    { "id": "scapegoat", "deck": "fate", "name": "背锅侠", "weight": 10, "maxCopies": 3, "target": "randomOther", "timing": "immediate", "text": ["项目黄了，复盘会上你被点名。", "你甚至不太确定那个需求是谁提的。"], "detail": "随机一名对手现金 −8000，你现金 +3000", "effects": [ { "op": "transferCash", "target": "randomOther", "delta": -8000 }, { "op": "cash", "delta": 3000 } ], "icon": "blame" },
    { "id": "bluescreen", "deck": "fate", "name": "蓝屏", "weight": 10, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["你的电脑蓝屏了。今晚的方案还在上面。", "你重启了三次，第四次它终于承认自己坏了。"], "detail": "现金 −8000（买新设备）", "effects": [ { "op": "cash", "delta": -8000 }, { "op": "stat", "key": "energy", "delta": -10 } ], "icon": "screen" },
    { "id": "sick-leave", "deck": "fate", "name": "急病", "weight": 10, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["你在电梯里突然晕了一下。同事扶住了你，也顺便扶走了你的工位。"], "detail": "跳过下一回合，医疗 −5000", "effects": [ { "op": "cash", "delta": -5000 }, { "op": "skipNext", "count": 1 }, { "op": "stat", "key": "energy", "delta": -25 } ], "icon": "health" },
    { "id": "overtime-night", "deck": "fate", "name": "通宵", "weight": 11, "maxCopies": 4, "target": "self", "timing": "immediate", "text": ["需求在 18:47 变更。你看着它，想起了大学时的自己。"], "detail": "精力 −30，月薪临时打折", "effects": [ { "op": "stat", "key": "energy", "delta": -30 }, { "op": "salaryCoefficientDelta", "delta": -0.1 } ], "icon": "night" },
    { "id": "reimburse-deny", "deck": "fate", "name": "报销驳回", "weight": 10, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["财务说这张单超标了。超标 3 块钱的单子。"], "detail": "现金 −6000", "effects": [ { "op": "cash", "delta": -6000 }, { "op": "stat", "key": "mood", "delta": -10 } ], "icon": "money" },
    { "id": "colleague-quit", "deck": "fate", "name": "同事跑路", "weight": 9, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["最熟悉这块业务的人提了离职。最后一天他说了句「文档在共享盘」。", "共享盘里没有文档。"], "detail": "现金 −10000，精力 −20", "effects": [ { "op": "cash", "delta": -10000 }, { "op": "stat", "key": "energy", "delta": -20 } ], "icon": "door" },
    { "id": "audit", "deck": "fate", "name": "突击审计", "weight": 8, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["审计提前了。你桌上有一杯没洗的咖啡和一份不该出现的文档。"], "detail": "现金 −15000", "effects": [ { "op": "cash", "delta": -15000 }, { "op": "stat", "key": "mood", "delta": -15 } ], "icon": "search" },
    { "id": "gossip", "deck": "fate", "name": "被八卦", "weight": 10, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["有人在群里说了句什么，然后所有人都看向你。"], "detail": "心情 −20，面子 −3", "effects": [ { "op": "stat", "key": "mood", "delta": -20 }, { "op": "stat", "key": "face", "delta": -3 } ], "icon": "whisper" },
    { "id": "system-crash", "deck": "fate", "name": "系统宕机", "weight": 9, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["生产环境挂了 2 小时。你在会议室待了 5 小时，什么也做不了。"], "detail": "现金 −12000，精力 −15", "effects": [ { "op": "cash", "delta": -12000 }, { "op": "stat", "key": "energy", "delta": -15 } ], "icon": "server" },
    { "id": "boss-anger", "deck": "fate", "name": "老板发火", "weight": 9, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["周会上他点了你的名。你的方案他昨天说过要「再打磨打磨」。"], "detail": "心情 −25，工资系数 −8%", "effects": [ { "op": "salaryCoefficientDelta", "delta": -0.08 }, { "op": "stat", "key": "mood", "delta": -25 } ], "icon": "anger" },
    { "id": "invoice", "deck": "fate", "name": "账单集中期", "weight": 9, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["信用卡账单、花呗账单、房租账单，邮箱里躺成一排。"], "detail": "现金 −11000", "effects": [ { "op": "cash", "delta": -11000 } ], "icon": "money" },
    { "id": "lost-phone", "deck": "fate", "name": "手机丢了", "weight": 9, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["地铁上人太多。你的手机和它里面所有的支付功能一起消失了。"], "detail": "现金 −9000", "effects": [ { "op": "cash", "delta": -9000 }, { "op": "stat", "key": "mood", "delta": -12 } ], "icon": "phone" },
    { "id": "spam-piyo", "deck": "fate", "name": "画饼充饥", "weight": 11, "maxCopies": 4, "target": "self", "timing": "immediate", "text": ["老板画了一个很大的饼，还给你倒了杯水。"], "detail": "心情 −15，精力 −10（饼太大消化不了）", "effects": [ { "op": "stat", "key": "mood", "delta": -15 }, { "op": "stat", "key": "energy", "delta": -10 } ], "icon": "pie" },
    { "id": "project-fail", "deck": "fate", "name": "项目黄了", "weight": 7, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["三个月的项目，今天早上被判定为「方向性错误」。"], "detail": "现金 −15000，职级下降一级", "effects": [ { "op": "cash", "delta": -15000 }, { "op": "rankCheck", "delta": -1 }, { "op": "stat", "key": "mood", "delta": -20 } ], "icon": "fail" },
    { "id": "credit-cut", "deck": "fate", "name": "征信花了", "weight": 6, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["你查了一下征信，发现去年有笔忘记还。"], "detail": "贷款利率上升，现金 −8000", "effects": [ { "op": "cash", "delta": -8000 }, { "op": "loanRateDelta", "delta": 0.005 } ], "icon": "bank" },
    { "id": "seat-taken", "deck": "fate", "name": "工位被占", "weight": 9, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["新同事的工位安排在了你的位置上。你现在抱着显示器站着。"], "detail": "心情 −20，精力 −10", "effects": [ { "op": "stat", "key": "mood", "delta": -20 }, { "op": "stat", "key": "energy", "delta": -10 } ], "icon": "chair" },
    { "id": "favors", "deck": "fate", "name": "被拉去帮忙", "weight": 10, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["隔壁组缺人，老板说「你去帮一下」。你的项目怎么办？他没说。"], "detail": "本月收入 −20%，精力 −20", "effects": [ { "op": "cash", "delta": -12000 }, { "op": "stat", "key": "energy", "delta": -20 } ], "icon": "help" },
    { "id": "price-hike", "deck": "fate", "name": "物价飞涨", "weight": 9, "maxCopies": 3, "target": "self", "timing": "immediate", "text": ["楼下咖啡从 25 涨到 32。你还是点了。"], "detail": "生活开销永久 +15%", "effects": [ { "op": "livingCostDelta", "delta": 0.15 }, { "op": "stat", "key": "mood", "delta": -10 } ], "icon": "chart" },
    { "id": "broken-heater", "deck": "fate", "name": "房东失联", "weight": 8, "maxCopies": 2, "target": "self", "timing": "immediate", "text": ["暖气不热，你发了三条消息，收到一条「在处理」。那是三周前。"], "detail": "现金 −7000，精力 −15", "effects": [ { "op": "cash", "delta": -7000 }, { "op": "stat", "key": "energy", "delta": -15 } ], "icon": "repair" }
  ]
